# apps/web/.env.example

# NextAuth & Discord OAuth2
# Create an application at https://discord.com/developers/applications
# Add Redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
NEXTAUTH_SECRET="generate_a_random_32_character_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Bot Internal API Connection (Server-to-Server)
INTERNAL_BOT_API_URL="http://127.0.0.1:4000"
BOT_API_ADMIN_TOKEN="super_secret_bot_api_admin_token_change_me"

# Public WebSocket URL for Live Player Sync (Client Browser to Bot Socket.io)
NEXT_PUBLIC_BOT_SOCKET_URL="http://localhost:4000"

# Spotify Integration
SPOTIFY_CLIENT_ID="3951a3c0933f4c0fb55d7399a9d8d14a"
SPOTIFY_CLIENT_SECRET="199ecc091d8041e58cb11af3f23386ee"
SPOTIFY_REDIRECT_URI="https://play.lukka.dev/api/spotify/callback"

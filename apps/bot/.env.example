# apps/bot/.env.example

# Discord Bot Credentials
BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
BOT_OWNER_ID="YOUR_DISCORD_USER_ID"
TEST_GUILD_ID="YOUR_TEST_DISCORD_GUILD_ID"

# Database Configuration (Default SQLite, optionally PostgreSQL or MySQL)
# DATABASE_TYPE="sqlite"
# DATABASE_NAME="database.sqlite"

# Internal Koa REST API & WebSocket Server
API_PORT=4000
API_ADMIN_TOKEN="super_secret_bot_api_admin_token_change_me"
FRONTEND_URL="http://localhost:3000"

# Optional External API Keys (e.g. Genius / Imgur)
# IMGUR_CLIENT_ID=""

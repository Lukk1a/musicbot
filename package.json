{
  "name": "musicbot-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"@musicbot/*\" run build",
    "type:check": "pnpm --filter \"@musicbot/*\" run type:check",
    "dev:bot": "pnpm --filter \"@musicbot/bot\" dev",
    "dev:web": "pnpm --filter \"@musicbot/web\" dev",
    "env:apply": "node scripts/apply-env.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "discord-voip": "npm:@discordjs/voice@^0.19.2",
    "discord-api-types": "^0.38.57"
  }
}
